---
/**
 * Renders one tool with its page defaults: `fit` (props: mode, region, unit), `fees` (props: airline,
 * bags, only), `liquids` (props: country, airport), `battery`, or `mini:<spec>` from `lib/mini-specs.ts`.
 */
import FitCheck from './calc/FitCheck';
import FeeCalc from './calc/FeeCalc';
import LiquidsCheck from './calc/LiquidsCheck';
import PowerBank from './calc/PowerBank';
import MiniSim from './calc/MiniSim';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { getSpec } from '../lib/mini-specs';
import { AIRLINES } from '../lib/engine/bags';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; lang?: Locale; primary?: boolean; idPrefix?: string; seedKey?: string }
const { tool, lang = 'en', primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const kind = tool.kind;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage && hasRoute(spec.ctaPage, lang) ? route(spec.ctaPage, lang) : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) if (typeof v === 'number') numDefaults[k] = v;
const links = Object.fromEntries(AIRLINES.filter((a) => hasRoute(a.id, lang)).map((a) => [a.id, route(a.id, lang)]));
---
{kind === 'fit' && <FitCheck client:load idPrefix={idPrefix ?? (primary ? 'fit' : 'fit2')} mode={props.mode ?? 'carry'} region={props.region ?? 'all'} unit={props.unit ?? 'in'} primary={primary} links={links} />}
{kind === 'fees' && <FeeCalc client:load idPrefix={idPrefix ?? (primary ? 'fee' : 'fee2')} airline={props.airline ?? 'united'} bags={props.bags ?? 1} only={props.only} primary={primary} />}
{kind === 'liquids' && <LiquidsCheck client:load idPrefix={idPrefix ?? (primary ? 'liq' : 'liq2')} country={props.country ?? 'us'} airport={props.airport} primary={primary} />}
{kind === 'battery' && <PowerBank client:load idPrefix={idPrefix ?? (primary ? 'pb' : 'pb2')} region={props.region ?? 'us'} primary={primary} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
