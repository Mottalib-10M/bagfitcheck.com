---
/** Attributions required by the licences (RECETTE §12.1). Shown at the foot of every page, embeds included. */
interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
const OGL = 'https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/';
---
<p class={cls} data-licence-notice>
  Contains public sector information licensed under the <a class="underline" href={OGL} target="_blank" rel="noopener">Open Government Licence v3.0</a> (GOV.UK pages of the Department for Transport). TSA and FAA pages are works of the US government; neither agency endorses this site.
  Airline names are trademarks of their owners; no airline is affiliated with, sponsors or reviews this site. Sizes, weights and fees are facts read on each airline's own page; explanations and tools written by Radif Partners.
</p>
