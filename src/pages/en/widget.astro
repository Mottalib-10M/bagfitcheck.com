---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/will-my-bag-fit/" title="Will my bag fit? Carry-on size checker" width="100%" height="760" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/bag-fee-calculator/" title="Round-trip bag fee calculator" width="100%" height="760" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code3 = `<iframe src="${SITE_URL}/embed/liquids-checker/" title="Liquids in hand luggage checker" width="100%" height="620" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free carry-on size checker on your website" description="Put the bag size checker, the round-trip bag fee calculator or the liquids checker on your travel site: one iframe, no sign-up, no tracking, no cookie, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a bag tool</h1>
    <p class="mt-3 text-lg text-navy-700">For travel guides, school trip organizers, study-abroad offices and community sites.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Will my bag fit?</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Round-trip bag fees</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <h2>Liquids checker</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code3}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When an airline changes a size or a fee, the embedded tool updates with the site. Nothing your visitors type reaches us and the frame sets no cookie. Each frame states that the site is independent and not an airline. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/will-my-bag-fit/" title="Will my bag fit?" width="100%" height="760" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
